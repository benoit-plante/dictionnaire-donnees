msgstr "The {instrument} measures {what} with {k} items, rated from {low} to {high} {missing}."

msgid ""
"L'interface de révision n'est pas installée. Installez-la avec : uv tool install --reinstall "
"\".[ia,revision]\" (voir docs/installation-windows.md)."
msgstr ""
"The review interface is not installed. Install it with: uv tool install --reinstall "
"\".[ia,revision]\" (see docs/installation-windows.md)."

